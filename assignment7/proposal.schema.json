{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:abi:assignment7:proposal:v1",
  "title": "Employee complaint handling proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary_claims",
    "missing_information",
    "urgency_level",
    "routing_destination",
    "escalation_required",
    "next_action_id"
  ],
  "properties": {
    "summary_claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "start",
          "end",
          "quote"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "missing_information": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "transaction_date",
          "transaction_amount",
          "prior_case_reference",
          "requested_outcome",
          "other_context"
        ]
      }
    },
    "urgency_level": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical",
        "Unknown"
      ]
    },
    "routing_destination": {
      "type": "string",
      "enum": [
        "Card Billing Disputes",
        "Card Fraud & Security",
        "Unknown"
      ]
    },
    "escalation_required": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "next_action_id": {
      "type": "string",
      "enum": [
        "REQUEST_INFORMATION",
        "PREPARE_BILLING_REVIEW",
        "PREPARE_SPECIALIST_REVIEW",
        "MANUAL_REVIEW"
      ]
    }
  }
}
